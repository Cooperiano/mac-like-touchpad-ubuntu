[Unit]
Description=macOS-style three-finger drag for the touchpad
After=graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=/dev/uinput

[Service]
Type=exec
ExecStart=/usr/local/bin/linux-3-finger-drag
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=graphical-session.target
